# Copy this file to .env for local configuration. Never commit .env.
WAGGLE_ENV=development

# Panel administrator
WAGGLE_ADMIN_USERNAME=admin
WAGGLE_ADMIN_PASSWORD=replace-with-a-strong-password

# Edge services that submit events and generated reports
WAGGLE_DEVICE_KEY=replace-with-a-long-random-device-key

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WAGGLE_SESSION_SECRET=replace-with-a-long-random-session-secret
WAGGLE_SESSION_SECONDS=28800
# How long a session lasts when the user ticks "Oturumumu açık tut" at sign-in.
# It only lengthens the session; the password itself is never stored by the panel.
WAGGLE_REMEMBERED_SESSION_SECONDS=2592000
WAGGLE_SECURE_COOKIE=0
WAGGLE_LOGIN_MAX_ATTEMPTS=5
WAGGLE_LOGIN_WINDOW_SECONDS=300
WAGGLE_DEVICE_STALE_SECONDS=900
WAGGLE_REPORT_STALE_SECONDS=691200
WAGGLE_MAX_BACKUP_BYTES=104857600

# Demo mode. Never enable this on a real panel: it seeds a built-in "admin" owner with
# the well-known WAGGLE_ADMIN_PASSWORD, and the panel presents new hives as if their
# profile were already trained. The seeded account cannot sign in once this is back to 0,
# and it never blocks first-time setup, so a real owner can be registered alongside it.
# `python tools/run_demo.py` sets this for you.
WAGGLE_DEMO_MODE=0

# Local storage and field context
WAGGLE_DB=panel/data/waggle.db
WAGGLE_LOCATION=Gölbaşı Arılığı
WAGGLE_LAT=39.7897
WAGGLE_LON=32.8065

# Enrollment thresholds. The defaults (42 recordings across 14 distinct days plus 4
# field confirmations) are what makes a hive profile seasonal instead of a snapshot.
# Lower them only to record a walkthrough of the flow, never in the field.
# WAGGLE_ENROLLMENT_RECORDINGS=42
# WAGGLE_ENROLLMENT_DAYS=14
# WAGGLE_ENROLLMENT_CONFIRMATIONS=4

# Model backed report generation (off unless a local model is available)
WAGGLE_LLM_ENABLED=0
WAGGLE_LLM_MODEL=phi-3.5-mini
WAGGLE_LLM_TIMEOUT=180
# Optional second local model. When set, its priority is compared with the first model's
# and the more cautious of the two is kept, so one model's slip cannot set the priority on
# its own. Leave empty for a single-model panel. It must be a model Foundry Local has
# cached; a small tool-capable one such as qwen2.5-1.5b costs about two seconds.
WAGGLE_CROSS_CHECK_MODEL=
# WAGGLE_FOUNDRY_BASE_URL=http://127.0.0.1:5273/v1
