# Copy this file to .env for local configuration. Never commit .env.
WAGGLE_ENV=development

# Panel administrator
WAGGLE_ADMIN_USERNAME=admin
WAGGLE_ADMIN_PASSWORD=replace-with-a-strong-password

# Edge services that submit events and generated reports
WAGGLE_DEVICE_KEY=replace-with-a-long-random-device-key

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WAGGLE_SESSION_SECRET=replace-with-a-long-random-session-secret
WAGGLE_SESSION_SECONDS=28800
# How long a session lasts when the user ticks "Oturumumu açık tut" at sign-in.
# It only lengthens the session; the password itself is never stored by the panel.
WAGGLE_REMEMBERED_SESSION_SECONDS=2592000
WAGGLE_SECURE_COOKIE=0
WAGGLE_LOGIN_MAX_ATTEMPTS=5
WAGGLE_LOGIN_WINDOW_SECONDS=300
WAGGLE_DEVICE_STALE_SECONDS=900
WAGGLE_REPORT_STALE_SECONDS=691200
WAGGLE_MAX_BACKUP_BYTES=104857600

# Demo mode. Never enable this on a real panel: it seeds a built-in "admin" owner with
# the well-known WAGGLE_ADMIN_PASSWORD, and the panel presents new hives as if their
# profile were already trained. The seeded account keeps signing in after this is back to
# 0 — being locked out of it was judged worse than the weak default it starts with, which
# is why start-up warns about that password instead. Change its password to clear the flag,
# or delete the account. It never blocks first-time setup, so a real owner can be
# registered alongside it.
# `python tools/run_demo.py` sets this for you.
WAGGLE_DEMO_MODE=0

# Local storage and field context
WAGGLE_DB=panel/data/waggle.db
WAGGLE_LOCATION=Gölbaşı Arılığı
# These only seed a brand new panel's settings row, and an upgrading panel keeps whatever
# pair it was already using. After that the apiary's position is edited in the panel
# itself, under Ayarlar → Genel, because a position that could only be set here was a
# position the panel reported wrongly the moment somebody renamed the apiary.
WAGGLE_LAT=39.7897
WAGGLE_LON=32.8065

# Enrollment thresholds. The defaults (42 recordings across 14 distinct days plus 4
# field confirmations) are what makes a hive profile seasonal instead of a snapshot.
# Lower them only to record a walkthrough of the flow, never in the field.
# WAGGLE_ENROLLMENT_RECORDINGS=42
# WAGGLE_ENROLLMENT_DAYS=14
# WAGGLE_ENROLLMENT_CONFIRMATIONS=4

# Acoustic model paths. The defaults are the packaged reference model, the directory a
# hive's own trained profile is written to, and the recorded joblib-versus-ONNX decision
# comparison the Sistem Durumu page reads. Set them only when the artefacts live elsewhere;
# a missing model file is reported on that page rather than failing silently.
# WAGGLE_SENSOR_MODEL=results/mendeley_isolation_monitor.onnx
# WAGGLE_HIVE_PROFILE_DIR=results/hive_profiles
# WAGGLE_ONNX_PARITY_REPORT=results/mendeley_onnx_parity.json

# Model backed report generation (off unless a local model is available)
# Panelden rapor üretimi. Açıkken Raporlar sayfasındaki "Yeni rapor üret" butonu görünür
# ve raporu yerel model üretir. Yerel model kurulu olmayan bir panelde kapalı kalmalı:
# panel sahip olmadığı bir yeteneği reklam etmesin.
WAGGLE_LLM_ENABLED=0
WAGGLE_LLM_MODEL=phi-3.5-mini
WAGGLE_LLM_TIMEOUT=180
# Let the local model phrase the report as well as decide it. Off because no locally
# available model writes Turkish worth reading: phi-3.5-mini passes every safety check and
# still produces sentences that mean nothing, and the report the panel falls back to is
# both correct and bilingual. The model decides priority and actions either way; this
# switch only governs the prose. Turn it on to evaluate a new model, not in the field.
WAGGLE_LLM_NARRATIVE=0
# The answer is streamed, so silence can be told apart from slowness: a run is abandoned
# after this many seconds without a token, while a model that is still writing is left to
# finish inside the total budget above.
WAGGLE_LLM_STALL_TIMEOUT=45
# Release the local models once a report run finishes. Off by default: the panel loads the
# same one or two models for every report, so this trades a reload on the next run for the
# memory they hold in between. Switch it on where that memory is needed elsewhere.
WAGGLE_LLM_UNLOAD_AFTER_REPORT=0
# Optional second local model. When set, its priority is compared with the first model's
# and the more cautious of the two is kept, so one model's slip cannot set the priority on
# its own. Leave empty for a single-model panel. It must be a model Foundry Local has
# cached; a small tool-capable one such as qwen2.5-1.5b costs about two seconds.
WAGGLE_CROSS_CHECK_MODEL=
# WAGGLE_FOUNDRY_BASE_URL=http://127.0.0.1:5273/v1
